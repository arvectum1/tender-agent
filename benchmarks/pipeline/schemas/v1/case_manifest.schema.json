{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arvectum.com/schemas/benchmark-pipeline/v1/case_manifest.schema.json",
  "title": "Benchmark Case Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "procurement_ref", "created_at", "source_bundle_sha256", "sources", "calibration_tags"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "procurement_ref": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "source_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "kind", "title", "public_url", "retrieved_at", "sha256", "local_path"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["NOTICE", "DOCUMENTATION", "AMENDMENT", "PROTOCOL", "ATTACHMENT", "OTHER"]},
          "title": {"type": "string", "minLength": 1},
          "public_url": {"type": "string", "minLength": 1},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "local_path": {"type": "string", "minLength": 1},
          "supersedes_source_id": {"type": "string", "minLength": 1}
        }
      }
    },
    "calibration_tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "notes": {"type": "string", "maxLength": 2000}
  }
}
